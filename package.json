{
  "name": "genshin-build-card",
  "version": "1.0.0",
  "description": "Genshin Build Card - desktop version",
  "author": "Gumakulka",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.gumakulka.genshinbuildcard",
    "productName": "Genshin Build Card",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "build/logo.jpg",
        "to": "assets/logo.jpg"
      },
      {
        "from": "build/favicon.png",
        "to": "assets/favicon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}.${ext}"
    }
  }
}
